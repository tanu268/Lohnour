{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Black",
					"slug": "black",
					"color": "#000000"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#ffffff"
				},
				{
					"name": "Dark Charcoal",
					"slug": "dark-charcoal",
					"color": "#111111"
				},
				{
					"name": "Sleek Gray",
					"slug": "sleek-gray",
					"color": "#767676"
				},
				{
					"name": "Light Gray",
					"slug": "light-gray",
					"color": "#f5f5f7"
				},
				{
					"name": "Soft Accent",
					"slug": "soft-accent",
					"color": "#0066cc"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--dark-charcoal)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--black)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
		}
	}
}
