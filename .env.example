# ==============================================================================
# LOHNOUR PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' at the repository root and fill in your local values.
# WARNING: NEVER commit '.env' to version control. It is protected by .gitignore.
# ==============================================================================

# 1. Deployment Configuration
# Path to your private SSH key file (e.g. C:\keys\my-key.key or ~/.ssh/id_rsa)
LOHNOUR_SSH_KEY=

# Remote SSH target host (user@ip or user@hostname)
LOHNOUR_SSH_HOST=ubuntu@193.122.206.31

# 2. Local Verification & Testing Credentials
# Credentials for running local automated Playwright verification (verify.py)
LOHNOUR_TEST_USER=
LOHNOUR_TEST_PASSWORD=
LOHNOUR_TEST_URL=http://localhost:8081/wp-admin
