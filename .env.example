# ==============================================================================
# LOHNOUR PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' at the repository root and fill in your local values.
# WARNING: NEVER commit '.env' to version control. It is protected by .gitignore.
# For production: Inject these variables securely via Portainer CE Stack UI.
# ==============================================================================

# 1. Production Database Configuration (Required by docker-compose.yml)
# Target MariaDB schema name (defaults to lohnour_wp if unset)
DB_NAME=lohnour_wp

# Unprivileged application database user (defaults to lohnour_user if unset)
DB_USER=lohnour_user

# Application database user password (DO NOT COMMIT REAL VALUE)
DB_PASSWORD=

# MariaDB administrative root password (DO NOT COMMIT REAL VALUE)
DB_ROOT_PASSWORD=

# 2. Host SSH Deployment Configuration (Workstation to Oracle VM)
# Path to your private SSH key file (e.g., ~/.ssh/oracle_key.key or D:\keys\ssh-key.key)
LOHNOUR_SSH_KEY=

# Remote SSH target host (user@ip)
LOHNOUR_SSH_HOST=opc@141.148.51.166

# 3. Local Verification & Testing Credentials (Optional / Local Dev Only)
LOHNOUR_TEST_USER=
LOHNOUR_TEST_PASSWORD=
LOHNOUR_TEST_URL=http://localhost:8081/wp-admin
